{
  "name": "allan-cabusora-portfolio",
  "version": "1.0.0",
  "description": "Personal website for Allan Cabusora - Fullstack Developer",
  "scripts": {
    "dev": "vite --port 8888",
    "dev:css": "npx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npx tailwindcss -i ./src/input.css -o ./src/output.css --minify && vite build",
    "predeploy": "npm run build",
    "serve": "npx serve . -l 8888"
  },
  "keywords": [
    "portfolio",
    "frontend",
    "developer",
    "musician"
  ],
  "author": "Allan Cabusora",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.1.1",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "react": "^19.2.7"
  }
}
